[Unit]
Description=OmegaGO visual-limbs LiteLLM router (master model gateway)
Documentation=https://docs.litellm.ai/docs/proxy/quick_start
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omegago
Group=omegago
WorkingDirectory=/opt/omegago/visual-limbs/router
# Mesh-facing by default: agent desktops/workers reach the gateway over the
# LAN. Every request still needs a valid virtual/master key — the bind is not
# an auth boundary. Bearer keys travel over plain HTTP, so on any segment you
# do not fully trust, either pin ROUTER_HOST to a private/overlay interface
# (e.g. the Contabo LAN or a WireGuard/Tailscale IP) or set 127.0.0.1 and
# terminate TLS in front (Argon gateway :8090 / Caddy / cloudflared).
Environment=ROUTER_HOST=0.0.0.0
Environment=ROUTER_PORT=8000
EnvironmentFile=-/etc/omegago/router.env
ExecStart=/opt/omegago/visual-limbs/router/.venv/bin/litellm \
    --config /opt/omegago/visual-limbs/router/litellm_config.yaml \
    --host ${ROUTER_HOST} --port ${ROUTER_PORT}
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
# Hardening: secrets come from router.env only; the unit sees no key material.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
