# /etc/omegago/router.env — copy this file, fill values, chmod 600.
# Never commit real values; secrets come from env only.

# --- required ---
LITELLM_MASTER_KEY=sk-omega-master-CHANGEME   # admin auth for /key/generate + smoke tests
OPENROUTER_API_KEY=                           # lane 2 overflow key (required unless OpenRouter is disabled)

# --- virtual key persistence (needed by issue_key.sh) ---
# LiteLLM stores virtual keys in Postgres. Leave unset to run keyless/dev mode.
DATABASE_URL=postgresql://litellm:CHANGEME@127.0.0.1:5432/litellm

# --- lane 3: parked media fleet endpoints (leave blank to disable) ---
FLEET_QWEN_CODER_URL=
FLEET_GEMMA_URL=
FLEET_QWEN_VL_URL=
FLEET_BGE_M3_URL=

# --- gateway bind ---
# 0.0.0.0 = reachable by remote mesh agents (key auth still required).
# 127.0.0.1 = loopback only, e.g. when fronted by the Argon gateway on :8090.
ROUTER_HOST=0.0.0.0
ROUTER_PORT=8000

# --- health sidecar ---
ROUTER_HEALTH_HOST=127.0.0.1
ROUTER_HEALTH_PORT=8010
HEALTH_PROBE_TIMEOUT=2.5
HEALTH_SATURATION_WARN=0.9
